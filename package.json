{
  "name": "nftm-workspace",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "NFTM_TOKEN=$(node -e \"console.log(crypto.randomUUID())\") pnpm -r --parallel dev",
    "start": "node packages/cli/src/main.ts",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
