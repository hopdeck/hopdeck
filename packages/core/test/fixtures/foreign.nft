# Tables named like the ones other tools create, to test how hopdeck recognises
# them. Only the names and chain layout imitate those tools; the rules are
# made up. (Real iptables-nft tables also carry xt expressions and a marker
# that plain nft cannot create; unit tests cover those separately.)

table inet firewalld {
	chain filter_INPUT {
		type filter hook input priority filter + 10; policy accept;
		ct state established,related accept
	}
}

table inet f2b-table {
	set addr-set-sshd {
		type ipv4_addr
		elements = { 203.0.113.7 }
	}

	chain f2b-chain {
		type filter hook input priority filter - 1; policy accept;
		tcp dport 22 ip saddr @addr-set-sshd reject
	}
}

table ip libvirt_network {
	chain forward {
		type filter hook forward priority filter; policy accept;
	}
}

table ip filter {
	chain INPUT {
		type filter hook input priority filter; policy accept;
	}

	chain FORWARD {
		type filter hook forward priority filter; policy drop;
		jump DOCKER-USER
	}

	chain DOCKER-USER {
		return
	}
}

table inet mine {
	chain input {
		type filter hook input priority filter; policy accept;
	}
}
