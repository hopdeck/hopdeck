{
  "nftables": [
    {
      "metainfo": {
        "version": "1.1.3",
        "release_name": "Commodore Bullmoose #4",
        "json_schema_version": 1
      }
    },
    {
      "table": {
        "family": "inet",
        "name": "firewalld",
        "handle": 3
      }
    },
    {
      "chain": {
        "family": "inet",
        "table": "firewalld",
        "name": "filter_INPUT",
        "handle": 1,
        "type": "filter",
        "hook": "input",
        "prio": 10,
        "policy": "accept"
      }
    },
    {
      "rule": {
        "family": "inet",
        "table": "firewalld",
        "chain": "filter_INPUT",
        "handle": 2,
        "expr": [
          {
            "match": {
              "op": "in",
              "left": {
                "ct": {
                  "key": "state"
                }
              },
              "right": [
                "established",
                "related"
              ]
            }
          },
          {
            "accept": null
          }
        ]
      }
    },
    {
      "table": {
        "family": "inet",
        "name": "f2b-table",
        "handle": 4
      }
    },
    {
      "chain": {
        "family": "inet",
        "table": "f2b-table",
        "name": "f2b-chain",
        "handle": 1,
        "type": "filter",
        "hook": "input",
        "prio": -1,
        "policy": "accept"
      }
    },
    {
      "set": {
        "family": "inet",
        "name": "addr-set-sshd",
        "table": "f2b-table",
        "type": "ipv4_addr",
        "handle": 2,
        "elem": [
          "203.0.113.7"
        ]
      }
    },
    {
      "rule": {
        "family": "inet",
        "table": "f2b-table",
        "chain": "f2b-chain",
        "handle": 3,
        "expr": [
          {
            "match": {
              "op": "==",
              "left": {
                "payload": {
                  "protocol": "tcp",
                  "field": "dport"
                }
              },
              "right": 22
            }
          },
          {
            "match": {
              "op": "==",
              "left": {
                "payload": {
                  "protocol": "ip",
                  "field": "saddr"
                }
              },
              "right": "@addr-set-sshd"
            }
          },
          {
            "reject": {
              "type": "icmp",
              "expr": "port-unreachable"
            }
          }
        ]
      }
    },
    {
      "table": {
        "family": "ip",
        "name": "libvirt_network",
        "handle": 5
      }
    },
    {
