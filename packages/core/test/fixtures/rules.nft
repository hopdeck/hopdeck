table inet t {
	set admins { type ipv4_addr; }
	chain other { }
	chain c {
		type filter hook input priority filter; policy drop;
		ct state established,related accept
		ct state new tcp dport 22 accept
		ct state invalid drop
		iif "lo" accept
		iifname "eth0" oifname "wg*" accept
		ip saddr 10.0.0.0/24 tcp dport { 80, 443 } counter accept
		ip saddr != 192.168.1.1 udp sport 1000-2000 drop
		ip6 daddr fe80::/10 icmpv6 type echo-request accept
		ip saddr @admins tcp dport 22 accept comment "ssh from admins"
		meta l4proto tcp reject with tcp reset
		icmp type echo-request limit rate 5/second burst 5 packets accept
		tcp dport 8080 log prefix "web: " level info drop
		tcp dport 25 reject
		udp dport 53 jump other
		tcp dport 3000-3010 goto other
		ip daddr 10.0.0.1-10.0.0.9 return
		ip saddr 1.2.3.4 counter name "hits" drop
		tcp dport 22 ip saddr 10.0.0.1 accept
	}
	counter hits { }
	chain nat {
		type nat hook prerouting priority dstnat; policy accept;
		tcp dport 80 dnat ip to 10.0.0.2:8080
		tcp dport 81 redirect to :8081
	}
	chain post {
		type nat hook postrouting priority srcnat; policy accept;
		oifname "eth0" masquerade
		ip saddr 10.0.0.0/24 snat ip to 1.2.3.4
	}
	chain lists {
		iifname { "eth0", "wg0" } accept
		oifname != { "eth1", "eth2" } drop
		tcp dport != { 80, 443 } drop
		ip saddr { 10.0.0.0/24, 192.168.1.10 } accept
		icmp type { echo-reply, echo-request } accept
		tcp dport { 80, 443, 8000-8080 } counter accept
	}
	map ports {
		type inet_service : verdict
		elements = { 22 : accept }
	}
	set dyn {
		type ipv4_addr
		size 65535
		flags dynamic,timeout
		timeout 1m
	}
	chain more {
		tcp flags syn accept
		tcp flags & (fin | syn | rst | ack) == syn accept
		tcp flags ! syn,ack drop
		tcp flags syn,ack accept
		tcp flags == syn accept
		tcp flags == syn | ack accept
		tcp flags == fin | syn accept
		tcp dport 22 tcp flags & (syn | ack) == syn accept
		limit rate over 10/second burst 5 packets drop
		limit rate 1 mbytes/second accept
		limit rate 100 kbytes/second burst 500 kbytes accept
		ct count over 20 reject
		meta length 0-100 accept
		meta length > 1000 drop
		meta mark 0x1 accept
		meta mark != 42 accept
		ct mark 0x10 accept
		meta mark set 0x1
		ct mark set 0x2 accept
		meta pkttype broadcast drop
		meta pkttype { broadcast, multicast } drop
		fib saddr . iif oif missing drop
		quota 100 mbytes accept
		quota over 1000 mbytes drop
		log group 1
		log prefix "x" group 2 accept
		notrack
		tcp dport vmap @ports
		tcp dport vmap { 22 : accept, 80 : jump other, 443 : drop }
		iifname vmap { "eth0" : accept, "wg0" : drop }
		tcp dport 22 ct state new add @dyn { ip saddr limit rate over 3/minute burst 5 packets } drop
		update @dyn { ip saddr timeout 1m limit rate over 5/minute burst 3 packets } drop
		meter m1 { ip saddr limit rate 10/second } accept
	}
}
