{
  "nftables": [
    {
      "metainfo": {
        "version": "1.1.3",
        "release_name": "Commodore Bullmoose #4",
        "json_schema_version": 1
      }
    },
    {
      "table": {
        "family": "inet",
        "name": "filter",
        "handle": 1
      }
    },
    {
      "chain": {
        "family": "inet",
        "table": "filter",
        "name": "input",
        "handle": 1,
        "type": "filter",
        "hook": "input",
        "prio": 0,
        "policy": "drop"
      }
    },
    {
      "chain": {
        "family": "inet",
        "table": "filter",
        "name": "ssh_in",
        "handle": 2
      }
    },
    {
      "chain": {
        "family": "inet",
        "table": "filter",
        "name": "forward",
        "handle": 3,
        "type": "filter",
        "hook": "forward",
        "prio": 0,
        "policy": "drop"
      }
    },
    {
      "counter": {
        "family": "inet",
        "name": "web",
        "table": "filter",
        "handle": 4,
        "packets": 0,
        "bytes": 0
      }
    },
    {
      "quota": {
        "family": "inet",
        "name": "monthly",
        "table": "filter",
        "handle": 5,
        "bytes": 104857600,
        "used": 0,
        "inv": true
      }
    },
    {
      "limit": {
        "family": "inet",
        "name": "slow",
        "table": "filter",
        "handle": 6,
        "rate": 10,
        "per": "second",
        "burst": 5
      }
    },
    {
      "ct helper": {
        "family": "inet",
        "name": "ftp",
        "table": "filter",
        "handle": 7,
        "type": "ftp",
        "protocol": "tcp",
        "l3proto": "inet"
      }
    },
    {
      "synproxy": {
        "family": "inet",
        "name": "syn",
        "table": "filter",
        "handle": 8,
        "mss": 1460,
        "wscale": 7
      }
    },
    {
      "set": {
        "family": "inet",
        "name": "admins",
        "table": "filter",
        "type": "ipv4_addr",
        "handle": 9,
        "flags": [
          "interval"
        ],
        "elem": [
          {
            "prefix": {
              "addr": "10.0.0.0",
              "len": 24
            }
          },
          "192.168.1.10"
        ]
      }
    },
    {
      "map": {
        "family": "inet",
        "name": "port_policy",
        "table": "filter",
        "type": "inet_service",
        "handle": 10,
        "map": "verdict",
        "elem": [
          [
            22,
            {
              "jump": {
                "target": "ssh_in"
              }
            }
          ],
          [
            8080,
            {
              "drop": null
            }
          ]
        ]
      }
    },
    {
      "flowtable": {
        "family": "inet",
        "name": "fast",
        "table": "filter",
        "handle": 11,
        "hook": "ingress",
        "prio": 0,
        "dev": "lo"
      }
    },
    {
      "rule": {
        "family": "inet",
        "table": "filter",
        "chain": "input",
        "handle": 12,
        "expr": [
          {
            "match": {
              "op": "in",
              "left": {
                "ct": {
                  "key": "state"
                }
              },
              "right": [
                "established",
                "related"
              ]
            }
          },
          {
            "accept": null
          }
        ]
      }
    },
    {
      "rule": {
        "family": "inet",
        "table": "filter",
        "chain": "input",
        "handle": 13,
        "expr": [
          {
            "match": {
              "op": "==",
              "left": {
                "meta": {
                  "key": "iif"
                }
              },
              "right": "lo"
            }
          },
          {
            "accept": null
          }
        ]
      }
    },
    {
      "rule": {
        "family": "inet",
        "table": "filter",
        "chain": "input",
        "handle": 14,
        "expr": [
          {
            "vmap": {
              "key": {
                "payload": {
                  "protocol": "tcp",
                  "field": "dport"
                }
              },
              "data": "@port_policy"
            }
          }
        ]
      }
    },
    {
      "rule": {
        "family": "inet",
        "table": "filter",
        "chain": "input",
        "handle": 16,
        "expr": [
          {
            "match": {
              "op": "==",
              "left": {
                "payload": {
                  "protocol": "tcp",
                  "field": "dport"
                }
              },
              "right": {
                "set": [
                  80,
                  443
                ]
              }
            }
          },
          {
            "counter": "web"
          },
          {
            "accept": null
          }
        ]
      }
    },
    {
      "rule": {
        "family": "inet",
        "table": "filter",
        "chain": "ssh_in",
        "handle": 17,
        "comment": "ssh from admins",
        "expr": [
          {
            "match": {
              "op": "==",
              "left": {
                "payload": {
                  "protocol": "ip",
                  "field": "saddr"
                }
              },
              "right": "@admins"
            }
          },
          {
            "accept": null
          }
        ]
      }
    },
    {
      "table": {
        "family": "ip",
        "name": "nat",
        "handle": 2
      }
    },
    {
      "chain": {
        "family": "ip",
        "table": "nat",
        "name": "postrouting",
        "handle": 1,
        "type": "nat",
        "hook": "postrouting",
        "prio": 100,
        "policy": "accept"
      }
    },
    {
      "rule": {
        "family": "ip",
        "table": "nat",
        "chain": "postrouting",
        "handle": 2,
        "expr": [
          {
            "match": {
              "op": "==",
              "left": {
                "meta": {
                  "key": "oifname"
                }
              },
              "right": "eth0"
            }
          },
          {
            "masquerade": null
          }
        ]
      }
    }
  ]
}
