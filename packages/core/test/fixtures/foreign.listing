table inet firewalld { # handle 3
	chain filter_INPUT { # handle 1
		type filter hook input priority filter + 10; policy accept;
		ct state established,related accept # handle 2
	}
}
table inet f2b-table { # handle 4
	set addr-set-sshd { # handle 2
		type ipv4_addr
		elements = { 203.0.113.7 }
	}

	chain f2b-chain { # handle 1
		type filter hook input priority filter - 1; policy accept;
		tcp dport 22 ip saddr @addr-set-sshd reject with icmp port-unreachable # handle 3
	}
}
table ip libvirt_network { # handle 5
	chain forward { # handle 1
		type filter hook forward priority filter; policy accept;
	}
}
table ip filter { # handle 6
	chain INPUT { # handle 1
		type filter hook input priority filter; policy accept;
	}

	chain FORWARD { # handle 2
		type filter hook forward priority filter; policy drop;
		jump DOCKER-USER # handle 4
	}

	chain DOCKER-USER { # handle 3
		return # handle 5
	}
}
table inet mine { # handle 7
	chain input { # handle 1
		type filter hook input priority filter; policy accept;
	}
}
