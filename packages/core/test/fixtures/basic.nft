table inet filter {
	set admins {
		type ipv4_addr
		flags interval
		elements = { 10.0.0.0/24, 192.168.1.10 }
	}

	map port_policy {
		type inet_service : verdict
		elements = { 22 : jump ssh_in, 8080 : drop }
	}

	counter web { }
	quota monthly { over 100 mbytes }
	limit slow { rate 10/second }
	ct helper ftp { type "ftp" protocol tcp; }
	synproxy syn { mss 1460 wscale 7 }

	flowtable fast {
		hook ingress priority 0
		devices = { lo }
	}

	chain input {
		type filter hook input priority filter; policy drop;
		ct state established,related accept
		iif "lo" accept
		tcp dport vmap @port_policy
		tcp dport { 80, 443 } counter name "web" accept
	}

	chain ssh_in {
		ip saddr @admins accept comment "ssh from admins"
	}

	chain forward {
		type filter hook forward priority filter; policy drop;
	}
}

table ip nat {
	chain postrouting {
		type nat hook postrouting priority srcnat; policy accept;
		oifname "eth0" masquerade
	}
}
