table inet t { # handle 1
	counter hits { # handle 7
		packets 0 bytes 0
	}

	set admins { # handle 8
		type ipv4_addr
	}

	map ports { # handle 9
		type inet_service : verdict
		elements = { 22 : accept }
	}

	set dyn { # handle 10
		type ipv4_addr
		size 65535
		flags dynamic,timeout
		timeout 1m
	}

	set m1 { # handle 81
		type ipv4_addr
		size 65535
		flags dynamic
	}

	chain other { # handle 1
	}

	chain c { # handle 2
		type filter hook input priority filter; policy drop;
		ct state established,related accept # handle 11
		ct state new tcp dport 22 accept # handle 12
		ct state invalid drop # handle 13
		iif "lo" accept # handle 14
		iifname "eth0" oifname "wg*" accept # handle 15
		ip saddr 10.0.0.0/24 tcp dport { 80, 443 } counter packets 0 bytes 0 accept # handle 17
		ip saddr != 192.168.1.1 udp sport 1000-2000 drop # handle 18
		ip6 daddr fe80::/10 icmpv6 type echo-request accept # handle 19
		ip saddr @admins tcp dport 22 accept comment "ssh from admins" # handle 20
		meta l4proto tcp reject with tcp reset # handle 21
		icmp type echo-request limit rate 5/second burst 5 packets accept # handle 22
		tcp dport 8080 log prefix "web: " level info drop # handle 23
		tcp dport 25 reject # handle 24
		udp dport 53 jump other # handle 25
		tcp dport 3000-3010 goto other # handle 26
		ip daddr 10.0.0.1-10.0.0.9 return # handle 27
		ip saddr 1.2.3.4 counter name "hits" drop # handle 28
		tcp dport 22 ip saddr 10.0.0.1 accept # handle 29
	}

	chain nat { # handle 3
		type nat hook prerouting priority dstnat; policy accept;
		tcp dport 80 dnat ip to 10.0.0.2:8080 # handle 30
		tcp dport 81 redirect to :8081 # handle 31
	}

	chain post { # handle 4
		type nat hook postrouting priority srcnat; policy accept;
		oifname "eth0" masquerade # handle 32
		ip saddr 10.0.0.0/24 snat ip to 1.2.3.4 # handle 33
	}

	chain lists { # handle 5
		iifname { "wg0", "eth0" } accept # handle 35
		oifname != { "eth1", "eth2" } drop # handle 37
		tcp dport != { 80, 443 } drop # handle 39
		ip saddr { 10.0.0.0/24, 192.168.1.10 } accept # handle 41
		icmp type { echo-reply, echo-request } accept # handle 43
		tcp dport { 80, 443, 8000-8080 } counter packets 0 bytes 0 accept # handle 45
	}

	chain more { # handle 6
		tcp flags syn accept # handle 46
		tcp flags & (fin | syn | rst | ack) == syn accept # handle 47
		tcp flags ! syn,ack drop # handle 48
		tcp flags syn,ack accept # handle 49
		tcp flags == syn accept # handle 50
		tcp flags == 0x12 accept # handle 51
		tcp flags == 0x3 accept # handle 52
		tcp dport 22 tcp flags & (syn | ack) == syn accept # handle 53
		limit rate over 10/second burst 5 packets drop # handle 54
		limit rate 1 mbytes/second accept # handle 55
		limit rate 100 kbytes/second burst 500 kbytes accept # handle 56
		ct count over 20 reject # handle 57
		meta length 0-100 accept # handle 58
		meta length > 1000 drop # handle 59
		meta mark 0x00000001 accept # handle 60
		meta mark != 0x0000002a accept # handle 61
		ct mark 0x00000010 accept # handle 62
		meta mark set 0x00000001 # handle 63
		ct mark set 0x00000002 accept # handle 64
		meta pkttype broadcast drop # handle 65
		meta pkttype { broadcast, multicast } drop # handle 67
		fib saddr . iif oif missing drop # handle 68
		quota 100 mbytes accept # handle 69
		quota over 1000 mbytes drop # handle 70
		log group 1 # handle 71
		log prefix "x" group 2 accept # handle 72
		notrack # handle 73
		tcp dport vmap @ports # handle 74
		tcp dport vmap { 22 : accept, 80 : jump other, 443 : drop } # handle 76
		iifname vmap { "wg0" : drop, "eth0" : accept } # handle 78
		tcp dport 22 ct state new add @dyn { ip saddr limit rate over 3/minute burst 5 packets } drop # handle 79
		update @dyn { ip saddr timeout 1m limit rate over 5/minute burst 3 packets } drop # handle 80
		add @m1 { ip saddr limit rate 10/second burst 5 packets } accept # handle 82
	}
}
