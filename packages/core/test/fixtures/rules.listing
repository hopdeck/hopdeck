table inet t { # handle 1
	counter hits { # handle 5
		packets 0 bytes 0
	}

	set admins { # handle 6
		type ipv4_addr
	}

	chain other { # handle 1
	}

	chain c { # handle 2
		type filter hook input priority filter; policy drop;
		ct state established,related accept # handle 7
		ct state new tcp dport 22 accept # handle 8
		ct state invalid drop # handle 9
		iif "lo" accept # handle 10
		iifname "eth0" oifname "wg*" accept # handle 11
		ip saddr 10.0.0.0/24 tcp dport { 80, 443 } counter packets 0 bytes 0 accept # handle 13
		ip saddr != 192.168.1.1 udp sport 1000-2000 drop # handle 14
		ip6 daddr fe80::/10 icmpv6 type echo-request accept # handle 15
		ip saddr @admins tcp dport 22 accept comment "ssh from admins" # handle 16
		meta l4proto tcp reject with tcp reset # handle 17
		icmp type echo-request limit rate 5/second burst 5 packets accept # handle 18
		tcp dport 8080 log prefix "web: " level info drop # handle 19
		tcp dport 25 reject # handle 20
		udp dport 53 jump other # handle 21
		tcp dport 3000-3010 goto other # handle 22
		ip daddr 10.0.0.1-10.0.0.9 return # handle 23
		ip saddr 1.2.3.4 counter name "hits" drop # handle 24
		tcp dport 22 ip saddr 10.0.0.1 accept # handle 25
	}

	chain nat { # handle 3
		type nat hook prerouting priority dstnat; policy accept;
		tcp dport 80 dnat ip to 10.0.0.2:8080 # handle 26
		tcp dport 81 redirect to :8081 # handle 27
	}

	chain post { # handle 4
		type nat hook postrouting priority srcnat; policy accept;
		oifname "eth0" masquerade # handle 28
		ip saddr 10.0.0.0/24 snat ip to 1.2.3.4 # handle 29
	}
}
