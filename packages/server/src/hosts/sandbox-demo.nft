# Demo firewall for the sandbox host. It lives in a private network namespace
# and never touches the real firewall.

table inet filter {
	set admins {
		type ipv4_addr
		flags interval
		elements = { 10.0.0.0/24, 192.168.1.10 }
	}

	set blocklist {
		type ipv4_addr
		flags timeout
	}

	map port_policy {
		type inet_service : verdict
		elements = { 22 : jump ssh_in, 8080 : drop }
	}

	counter web { }

	chain input {
		type filter hook input priority filter; policy drop;
		ct state established,related counter accept
		ct state invalid drop
		iif "lo" counter accept
		ip saddr @blocklist drop
		icmp type echo-request limit rate 5/second accept
		tcp dport vmap @port_policy
		tcp dport { 80, 443 } counter name "web" accept
	}

	chain ssh_in {
		ip saddr @admins accept comment "SSH from admins only"
	}

	chain forward {
		type filter hook forward priority filter; policy drop;
	}

	chain output {
		type filter hook output priority filter; policy accept;
	}
}

table ip nat {
	chain postrouting {
		type nat hook postrouting priority srcnat; policy accept;
		oifname "eth0" masquerade
	}
}
